// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
	{
		// Run the SWISSBuildings GML parser (parser.py) against the demo dataset.
		// The interpreter is picked up from the project's `.venv` automatically.
		"label": "Parse GML (demo_Hinterrhein)",
		"adapter": "Debugpy",
		"request": "launch",
		"program": "parser.py",
		"args": ["-f", "demo_Hinterrhein.gml"],
		"cwd": "$ZED_WORKTREE_ROOT"
	}
]
